{
  "name": "BeepTronics ESP32-S3-WROOM-1-N16 (16 MB, no PSRAM)",
  "vendor": "BeepTronics",
  "url": "https://www.espressif.com/en/products/modules/esp32-s3",
  "build": {
    "arduino": { "ldscript": "esp32s3_out.ld", "memory_type": "qio_qspi" },
    "core": "esp32",
    "mcu": "esp32s3",
    "variant": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "extra_flags": [
      "-DARDUINO_ESP32S3_DEV",
      "-DARDUINO_USB_MODE=1",
      "-DARDUINO_RUNNING_CORE=1",
      "-DARDUINO_EVENT_RUNNING_CORE=1"
    ],
    "hwids": [["0x303A", "0x1001"]]
  },
  "connectivity": ["wifi", "bluetooth"],
  "frameworks": ["arduino"],
  "upload": {
    "flash_size": "16MB",
    "maximum_size": 16777216,
    "maximum_ram_size": 327680,
    "require_upload_port": true,
    "speed": 460800
  },
  "debug": { "openocd_target": "esp32s3.cfg" }
}
